# Root .env.compose is canonical. Use this only for direct worker runs.
APP_ENV=development
APP_DEV_MODE=true
REDIS_URL=redis://localhost:6379/0
BACKEND_API_URL=http://localhost:54800
WORKER_CALLBACK_SECRET=resume-builder-local-worker-secret
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=
TIER1_MODEL=anthropic/claude-sonnet-5.5
TIER1_FALLBACK_MODEL=openai/gpt-6.1-sol
TIER2_MODEL=google/gemini-3.8-flash
TIER2_FALLBACK_MODEL=openai/gpt-6-luna
