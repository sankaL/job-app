# Root .env.compose is canonical. Use this only for direct backend runs.
APP_ENV=development
APP_DEV_MODE=true
API_PORT=8000
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:resume-builder-local-postgres-password@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<your-key>\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<your-key>\n-----END PUBLIC KEY-----
WORKER_CALLBACK_SECRET=resume-builder-local-worker-secret
DUPLICATE_SIMILARITY_THRESHOLD=85
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# OpenRouter (optional, for resume upload LLM cleanup)
OPENROUTER_API_KEY=
# Set true and supply a key to trace normal local runs; tests keep tracing off.
LANGSMITH_TRACING=false
# Backend and worker must use the same project. Use applix-prod in production.
LANGSMITH_PROJECT=applix-dev
# Required for organization-scoped keys or keys covering multiple workspaces.
LANGSMITH_WORKSPACE_ID=
LANGSMITH_API_KEY=
# Opt in to redacted prompt/output bodies on model runs. Leave false unless needed.
LANGSMITH_TRACE_CONTENT=false

# Resume import classification is advisory; local parsing is the default.
# Models are chosen by role in shared/model-config.json, not environment variables.
RESUME_IMPORT_CLASSIFIER=jev
RESUME_IMPORT_CONFIDENCE_THRESHOLD=0.8
