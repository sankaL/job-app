# Canonical local env for Compose and local app defaults
COMPOSE_PROJECT_NAME=resume-builder

# Host port overrides — auto-assigned on `make up` if preferred port is occupied
# Preferred: FRONTEND_PORT=5173 BACKEND_HOST_PORT=54800 POSTGRES_HOST_PORT=5432 REDIS_HOST_PORT=6379
FRONTEND_PORT=5173
BACKEND_HOST_PORT=54800
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Required local secrets
POSTGRES_PASSWORD=resume-builder-local-postgres-password
WORKER_CALLBACK_SECRET=resume-builder-local-worker-secret

# Generate your own RS256 keys for production:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl pkey -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
<your-private-key-here>
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
<your-public-key-here>
-----END PUBLIC KEY-----"

# Browser-facing local URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:54800

# Shared runtime toggle
APP_ENV=development
APP_DEV_MODE=true
# When APP_DEV_MODE=true, local login accepts an email without a password.
DUPLICATE_SIMILARITY_THRESHOLD=85

# Per-agent OpenRouter config
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set true and supply a key to trace normal local runs; tests keep tracing off.
LANGSMITH_TRACING=false
# Backend and worker must use the same project. Use applix-prod in production.
LANGSMITH_PROJECT=applix-dev
# Required for organization-scoped keys or keys covering multiple workspaces.
LANGSMITH_WORKSPACE_ID=
LANGSMITH_API_KEY=


# Leave key and from blank when email is off
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAILS=
INVITE_LINK_EXPIRY_HOURS=168

# Local seed user
LOCAL_DEV_USER_EMAIL=invite-only@example.com
LOCAL_DEV_USER_PASSWORD=ChangeMe123!
LOCAL_DEV_USER_IS_ADMIN=true

# Resume import classification is advisory; local parsing is the default.
RESUME_IMPORT_CLASSIFIER=jev
OPENROUTER_CLASSIFICATION_MODEL=typesafe/jev-1.13
RESUME_IMPORT_CONFIDENCE_THRESHOLD=0.8
TIER1_MODEL=anthropic/claude-sonnet-5.5
TIER1_FALLBACK_MODEL=openai/gpt-6.1-sol
TIER2_MODEL=google/gemini-3.8-flash
TIER2_FALLBACK_MODEL=openai/gpt-6-luna
